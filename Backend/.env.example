# Aiven MySQL Connection
# Get credentials from: https://console.aiven.io
# Format: mysql+pymysql://user:password@host:port/database?ssl-mode=REQUIRED
DATABASE_URL=mysql+pymysql://avnadmin:your_password_here@mysql-xxxxx.aivencloud.com:3306/electricite_db?ssl-mode=REQUIRED

# FastAPI Configuration
DEBUG=False

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:5173

# Optional: Authentication (for future use)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
