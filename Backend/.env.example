# Aiven MySQL Connection
# Get credentials from: https://console.aiven.io
# Format: mysql+pymysql://user:password@host:port/database?ssl-mode=REQUIRED
DATABASE_URL=mysql+pymysql://avnadmin:your_password_here@mysql-xxxxx.aivencloud.com:3306/electricite_db?ssl-mode=REQUIRED

# FastAPI Configuration
DEBUG=False

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:5173

# Optional: Authentication (for future use)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# ====================================
# EMAIL SERVICE CONFIGURATION
# ====================================

# SMTP Server Settings (Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Gmail: Use your Gmail email and App Password (not regular password)
# Generate App Password at: https://myaccount.google.com/apppasswords
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here

# For other providers (Outlook, custom SMTP server), adjust these values
# Example for Outlook:
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@outlook.com
# SENDER_PASSWORD=your-password

# Frontend Base URL for E-signature links
FRONTEND_BASE_URL=http://localhost:5173

# For production:
# FRONTEND_BASE_URL=https://yourdomain.com